PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (ej: Neon / Render / Railway)
DATABASE_URL=postgresql://usuario:password@host:5432/database?sslmode=require

# Autenticación JWT
JWT_SECRET=tu_secreto_jwt_seguro

# Algolia (búsqueda geoespacial)
ALGOLIA_APP_ID=tu_algolia_app_id
ALGOLIA_API_KEY=tu_algolia_admin_api_key
ALGOLIA_INDEX_NAME=pets

# Cloudinary (almacenamiento de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# Resend (envío de emails de notificación)
RESEND_API_KEY=re_tu_resend_api_key
EMAIL_FROM=onboarding@resend.dev
